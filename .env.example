# PolicyGPT Environment Configuration Template

# ==========================================
# 1. Backend Config (FastAPI)
# ==========================================
PORT=8000
ENVIRONMENT=development
# Local development uses SQLite by default (no database server needed).
# For PostgreSQL: DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/policygpt
DATABASE_URL=sqlite:///./policygpt.db
CHROMA_PERSIST_DIR=./chroma_db
OPENAI_API_KEY=sk-mock-key-for-now

# Clerk JWT Verification (Optional in local development without auth sync)
CLERK_JWKS_URL=
CLERK_FRONTEND_API=

# Who may add / delete schemes (comma-separated emails or Clerk user ids).
# Leave empty during local development to let any signed-in user add schemes.
ADMIN_EMAILS=

# ==========================================
# 2. Frontend Config (Next.js)
# ==========================================
# Clerk Authentication Keys (Get yours from https://dashboard.clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder

# Next.js navigation configurations
NEXT_PUBLIC_API_URL=http://localhost:8000
